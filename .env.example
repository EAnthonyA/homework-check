# --- Database (SQLite via Node's built-in node:sqlite) ---
# Local dev: ./data/app.db ; Docker: /data/app.db (mounted volume)
DB_PATH="./data/app.db"

# --- Google OAuth ---
# 1. Google Cloud Console -> APIs & Services -> OAuth consent screen
#    (External, Testing mode; add family emails as test users).
# 2. Credentials -> Create credentials -> OAuth client ID -> Web application.
# 3. Add authorized redirect URIs for BOTH:
#      http://localhost:3000/api/auth/callback
#      https://<your-domain>/api/auth/callback
# 4. Enable the Google Calendar API.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Public origin of the app. REQUIRED in production — the OAuth callback uses it
# to build the redirect URI, and behind a proxy the auto-detected origin is the
# internal container (http://app:3000), which Google rejects with
# redirect_uri_mismatch. Use the exact https:// scheme.
APP_URL="https://<your-domain>"

# Public support contact displayed on the privacy page (required for Google OAuth verification).
SUPPORT_EMAIL=""

# --- Session & encryption secrets ---
# Generate with: openssl rand -hex 32
SESSION_SECRET=""
ENCRYPTION_KEY=""

# --- Homework source (login + homework page endpoints) ---
# Values are deliberately blank here — fill them in locally in .env (git-ignored).
# The repository must not name the upstream service.
HOMEWORK_SOURCE_BASE_URL=""
HOMEWORK_SOURCE_LOGIN_PAGE=""
HOMEWORK_SOURCE_LOGIN_ACTION=""
HOMEWORK_SOURCE_HOMEWORK_PAGE=""
HOMEWORK_SOURCE_USERNAME=""
HOMEWORK_SOURCE_PASSWORD=""
HOMEWORK_SOURCE_REMEMBER_FIELD=""
HOMEWORK_SOURCE_LOGIN_SUBMIT=""
# Optional browser fingerprint — leave blank to use the built-in macOS Chrome
# fingerprint. To present your exact browser, get the values from chrome://version
# or a "what's my user agent" page and paste them into .env.
HOMEWORK_SOURCE_USER_AGENT=""
HOMEWORK_SOURCE_ACCEPT_LANGUAGE=""
HOMEWORK_SOURCE_SEC_CH_UA=""
HOMEWORK_SOURCE_PLATFORM=""
# Set to 1 to dump the authenticated homework HTML to ./data/debug for selector tuning.
SCRAPER_DEBUG="0"

# --- App settings ---
# Comma-separated emails allowed to sign in (kids + any non-parent members).
# Parents in PARENT_EMAILS are always allowed. Leave empty to allow anyone.
ALLOWED_EMAILS=""
# Comma-separated parent emails; unmatched users become "kid".
PARENT_EMAILS=""
# Cron expression (Europe/Vilnius). Default: 15:00 every day.
SCRAPE_CRON="0 15 * * *"
UPLOAD_DIR="./data/uploads"
UPLOAD_RETENTION_DAYS="3"

# --- AI homework evaluation (Gemini) ---
# Google AI Studio API key. When set, every uploaded photo is sent to Gemini to
# judge whether the task is done and correct. Leave empty to skip AI evaluation.
GEMINI_API_KEY=""
# Vision model used for photo evaluation. Default: gemini-2.5-flash.
GEMINI_VISION_MODEL="gemini-2.5-flash"
