# Local secrets for running CI with `act`.
# Copy this file to `.secrets.act` (gitignored) and fill in real values.
# These mirror the GitHub Actions secrets used by the real CI pipeline.
#
# Lint/typecheck and Docker build/smoke-test jobs do NOT need any real
# secrets. Only add values here if you run the build-push or deploy jobs
# locally (rare).

# Required only for build-push / deploy jobs (not needed for lint/test):
# DOCKERHUB_USERNAME=
# DOCKERHUB_TOKEN=
# VPS_HOST=
# VPS_USER=
# VPS_SSH_KEY=

# App secrets synced to the VPS .env by the deploy workflow:
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# SESSION_SECRET=
# ENCRYPTION_KEY=
# PARENT_EMAILS=
# APP_URL=
# SCRAPE_CRON=
# HOMEWORK_SOURCE_BASE_URL=
# HOMEWORK_SOURCE_LOGIN_PAGE=
# HOMEWORK_SOURCE_LOGIN_ACTION=
# HOMEWORK_SOURCE_HOMEWORK_PAGE=
# HOMEWORK_SOURCE_USERNAME=
# HOMEWORK_SOURCE_PASSWORD=
# HOMEWORK_SOURCE_REMEMBER_FIELD=
# HOMEWORK_SOURCE_LOGIN_SUBMIT=
# HOMEWORK_SOURCE_USER_AGENT=
# HOMEWORK_SOURCE_ACCEPT_LANGUAGE=
# HOMEWORK_SOURCE_SEC_CH_UA=
# HOMEWORK_SOURCE_PLATFORM=
